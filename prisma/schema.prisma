datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id        Int        @id @default(autoincrement())
  sid       String     @unique // institution student ID (column A of the roster sheet)
  name      String
  email     String     @unique
  createdAt DateTime   @default(now())
  checkins  Checkin[]

  @@index([name])
}

model Session {
  id        Int        @id @default(autoincrement())
  date      DateTime   @unique
  createdAt DateTime   @default(now())
  checkins  Checkin[]
}

model Checkin {
  id        Int      @id @default(autoincrement())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId Int
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId Int
  createdAt DateTime @default(now())

  @@unique([studentId, sessionId]) // one check-in per student per day
}
